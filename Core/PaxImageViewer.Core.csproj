<Project Sdk="Microsoft.NET.Sdk">

  <!-- The viewer itself: a window and a control any Avalonia app can host (PAX Commander does). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PaxImageViewer</RootNamespace>
    <AssemblyName>PaxImageViewer.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0</Version>
    <!-- Windows-only parts (WIC, StrCmpLogicalW) are guarded at runtime. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

</Project>
